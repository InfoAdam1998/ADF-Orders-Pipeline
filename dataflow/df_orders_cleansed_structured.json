{
	"name": "df_orders_cleansed_structured",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_cleansed_order_items",
						"type": "DatasetReference"
					},
					"name": "SourceCleansedOrderItems"
				},
				{
					"dataset": {
						"referenceName": "ds_cleansed_orders",
						"type": "DatasetReference"
					},
					"name": "SourceCleansedOrders"
				},
				{
					"dataset": {
						"referenceName": "ds_cleansed_stores",
						"type": "DatasetReference"
					},
					"name": "SourceCleansedStores"
				},
				{
					"dataset": {
						"referenceName": "ds_cleansed_products",
						"type": "DatasetReference"
					},
					"name": "SourceCleansedProducts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_structured_stores_sql",
						"type": "DatasetReference"
					},
					"name": "SinkStructuredStores"
				},
				{
					"dataset": {
						"referenceName": "ds_structured_products_sql",
						"type": "DatasetReference"
					},
					"name": "SinkStructuredProducts"
				},
				{
					"dataset": {
						"referenceName": "ds_structured_orders_sql",
						"type": "DatasetReference"
					},
					"name": "SinkStructuredSOrders"
				}
			],
			"transformations": [
				{
					"name": "LeftJoinOrderItemsAndOrders"
				},
				{
					"name": "DerivedTimeStampStores"
				},
				{
					"name": "DerivedTimeStampProducts"
				},
				{
					"name": "DerivedTimeStampOrders"
				},
				{
					"name": "SelectColumnsOrders"
				},
				{
					"name": "AlterRowOrders"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ORDER_ID as integer,",
				"          PRODUCT_ID as string,",
				"          UNIT_PRICE as double,",
				"          QUANTITY as integer,",
				"          UPDATED_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> SourceCleansedOrderItems",
				"source(output(",
				"          ORDER_ID as integer,",
				"          ORDER_DATE as date,",
				"          CUSTOMER_ID as integer,",
				"          ORDER_STATUS as string,",
				"          STORE_ID as integer,",
				"          UPDATED_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> SourceCleansedOrders",
				"source(output(",
				"          STORE_ID as integer,",
				"          STORE_NAME as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          UPDATED_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> SourceCleansedStores",
				"source(output(",
				"          PRODUCT_ID as integer,",
				"          PRODUCT_NAME as string,",
				"          UNIT_PRICE as double,",
				"          UPDATED_TIMESTAMP as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> SourceCleansedProducts",
				"SourceCleansedOrderItems, SourceCleansedOrders join(SourceCleansedOrderItems@ORDER_ID == SourceCleansedOrders@ORDER_ID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> LeftJoinOrderItemsAndOrders",
				"SourceCleansedStores derive(UPDATED_TIMESTAMP = currentUTC()) ~> DerivedTimeStampStores",
				"SourceCleansedProducts derive(UPDATED_TIMESTAMP = currentUTC()) ~> DerivedTimeStampProducts",
				"SelectColumnsOrders derive(UPDATED_TIMESTAMP = currentUTC(),",
				"          SUBTOTAL = (UNIT_PRICE*QUANTITY),",
				"          ORDER_ITEM_ID = toInteger(concat(toString(ORDER_ID), toString(PRODUCT_ID)))) ~> DerivedTimeStampOrders",
				"LeftJoinOrderItemsAndOrders select(mapColumn(",
				"          ORDER_ID = SourceCleansedOrderItems@ORDER_ID,",
				"          ORDER_DATE,",
				"          CUSTOMER_ID,",
				"          ORDER_STATUS,",
				"          STORE_ID,",
				"          PRODUCT_ID,",
				"          UNIT_PRICE,",
				"          QUANTITY,",
				"          UPDATED_TIMESTAMP = SourceCleansedOrderItems@UPDATED_TIMESTAMP",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectColumnsOrders",
				"DerivedTimeStampOrders alterRow(upsertIf(true())) ~> AlterRowOrders",
				"DerivedTimeStampStores sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          STORE_ID as integer,",
				"          STORE_NAME as string,",
				"          LATITUDE as decimal(18,0),",
				"          LONGITUDE as decimal(18,0),",
				"          UPDATED_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['TRUNCATE TABLE [ORDERS].[STORES]'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('hash', 1),",
				"     preCommands: [],",
				"     postCommands: []) ~> SinkStructuredStores",
				"DerivedTimeStampProducts sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          PRODUCT_ID as integer,",
				"          PRODUCT_NAME as string,",
				"          UNIT_PRICE as decimal(18,0),",
				"          UPDATED_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['TRUNCATE TABLE [ORDERS].[PRODUCTS]'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('hash', 1),",
				"     preCommands: [],",
				"     postCommands: []) ~> SinkStructuredProducts",
				"AlterRowOrders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ORDER_ITEM_ID as integer,",
				"          ORDER_ID as integer,",
				"          ORDER_DATE as date,",
				"          CUSTOMER_ID as integer,",
				"          ORDER_STATUS as string,",
				"          STORE_ID as integer,",
				"          PRODUCT_ID as integer,",
				"          UNIT_PRICE as decimal(18,0),",
				"          QUANTITY as integer,",
				"          SUBTOTAL as decimal(18,0),",
				"          UPDATED_TIMESTAMP as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['ORDER_ITEM_ID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     partitionBy('key',",
				"          0,",
				"          ORDER_DATE",
				"     ),",
				"     preCommands: [],",
				"     postCommands: []) ~> SinkStructuredSOrders"
			]
		}
	}
}