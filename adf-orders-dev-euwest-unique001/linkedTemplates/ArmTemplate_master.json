{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-orders-dev-euwest-unique001"
		},
		"ls_akv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://akv-orders-unique-0001.vault.azure.net/"
		},
		"ls_dl_orders_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlordersunique001.dfs.core.windows.net/"
		},
		"ls_sql_orders_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver-orders-dev-0001.database.windows.net"
		},
		"ls_sql_orders_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-orders-dev"
		},
		"ls_sql_orders_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ls_st_orders_properties_typeProperties_serviceEndpoint": {
			"type": "string",
			"defaultValue": "https://stordersunique001.blob.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-orders-dev-euwest-unique001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_akv_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_akv_properties_typeProperties_baseUrl')]"
					},
					"ls_sql_orders_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_orders_properties_typeProperties_server')]"
					},
					"ls_sql_orders_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_orders_properties_typeProperties_database')]"
					},
					"ls_sql_orders_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_orders_properties_typeProperties_userName')]"
					},
					"ls_dl_orders_properties_typeProperties_url": {
						"value": "[parameters('ls_dl_orders_properties_typeProperties_url')]"
					},
					"ls_st_orders_properties_typeProperties_serviceEndpoint": {
						"value": "[parameters('ls_st_orders_properties_typeProperties_serviceEndpoint')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-orders-dev-euwest-unique001_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-orders-dev-euwest-unique001_ArmTemplate_0')]"
			]
		}
	]
}